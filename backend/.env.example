# Copier ce fichier en backend/.env puis remplir les valeurs (le fichier .env n'est jamais commité).

# Base de données (fichier créé dans backend/instance/)
DATABASE_URL=sqlite:///immobilier.db

# Clé secrète Flask : longue chaîne aléatoire, propre à chaque installation
# (ex. python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=

# Clé de signature des jetons JWT, DIFFÉRENTE de SECRET_KEY (même commande pour la générer).
# Obligatoire : l'application refuse de démarrer sans elle.
JWT_SECRET_KEY=

# true en production (HTTPS) : les cookies de session ne circulent alors qu'en HTTPS
JWT_COOKIE_SECURE=false

# Photos : dossier relatif à backend/, taille max d'une requête (5 Mo)
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=5242880

# Analyse de photo de maintenance (Gemini). Renseignez la clé localement, jamais dans Git.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Modèle de secours (stable) pour l'analyse photo si le principal reçoit un 429.
GEMINI_PHOTO_FALLBACK_MODEL=gemini-3.6-flash
# Modèle de secours pour le diagnostic RAG de maintenance si Gemini est lent ou surchargé.
GEMINI_MAINTENANCE_DIAGNOSTIC_FALLBACK_MODEL=gemini-3.6-flash
# Optionnel : modèles dédiés à l'assistant de réclamations.
GEMINI_RECLAMATION_MODEL=
GEMINI_RECLAMATION_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT=45

# L'assistant des reclamations utilise Gemini par defaut avec GEMINI_API_KEY.
RECLAMATIONS_LLM_PROVIDER=gemini
# Ollama peut etre choisi explicitement, avec un modele deja installe localement.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_RECLAMATION_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=180
# Modèle local prioritaire pour le RAG documentaire; Gemini reste le secours.
OLLAMA_RAG_MODEL=qwen2.5:3b
OLLAMA_RAG_TIMEOUT=60

# Modèles d'IA entraînés (estimation du prix) : dossier relatif à backend/, créé par
# « flask --app run entrainer-prix ». Il est ignoré par Git (.gitignore) : chaque poste réentraîne ses modèles.
MODELES_FOLDER=modeles

# Envoi des codes pour les connexions très inhabituelles (SMTP).
# Exemple Gmail : MAIL_SERVER=smtp.gmail.com, MAIL_PORT=587, MAIL_USE_TLS=true,
# MAIL_USERNAME=votre-adresse@gmail.com, MAIL_PASSWORD=mot-de-passe-application,
# MAIL_DEFAULT_SENDER=votre-adresse@gmail.com
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Conservation des événements du module sécurité (empreintes IP pseudonymisées).
CONNEXION_RETENTION_JOURS=180

# Module local de dossiers de litige. Laissez vide pour TF-IDF uniquement.
# Si renseigné, doit désigner le dossier d'un modèle sentence-transformers déjà présent sur ce poste.
DOSSIERS_LITIGE_MODELE_SEMANTIQUE=
